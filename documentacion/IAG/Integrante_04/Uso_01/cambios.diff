+<!DOCTYPE html>
+<html lang="es">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Crear cuenta - Gestión de Cultivos</title>
+    <link rel="stylesheet" href="css/styles.css">
+    <link rel="stylesheet" href="css/cuenta.css">
+</head>
+<body>
+    <header class="barra">
+        <a class="boton boton-secundario" href="index.html">Regreso a inicio</a>
+    </header>
+    <main class="login">
+        <section class="cuadro-login" aria-labelledby="titulo-cuenta">
+            <div class="logo" role="img" aria-label="lojo"></div>
+            <h1 id="titulo-cuenta">Gestión de Cultivos</h1>
+            <h2 class="titulo-cuenta">Crear cuenta</h2>
+            <div class="campos-cuenta">
+                <label for="nombre-cuenta">Nombre</label>
+                <input id="nombre-cuenta" type="text" autocomplete="name">
+
+                <label for="correo-cuenta">Correo</label>
+                <input id="correo-cuenta" type="email" autocomplete="email">
+
+                <label for="contrasena-cuenta">Contraseña</label>
+                <input id="contrasena-cuenta" type="password" autocomplete="new-password">
+
+                <button class="boton" type="button">Crear cuenta</button>
+            </div>
+        </section>
+    </main>
+</body>
+</html>
