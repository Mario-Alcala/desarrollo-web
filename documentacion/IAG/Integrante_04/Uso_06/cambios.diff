diff --git a/frontend/inventario.html b/frontend/inventario.html
new file mode 100644
index 0000000..6d9d358
--- /dev/null
+++ b/frontend/inventario.html
@@ -0,0 +1,86 @@
+<!DOCTYPE html>
+<html lang="es">
+    <head>
+        <meta charset="UTF-8">
+        <meta name="viewport" content="width=device-width, initial-scale=1.0">
+        <title>Inventario - Gestión de Cultivos</title>
+        <link rel="stylesheet" href="css/styles.css">
+        <link rel="stylesheet" href="css/cultivos.css">
+        <link rel="stylesheet" href="css/operaciones.css">
+    </head>
+    <body>
+        <header class="barra">
+            <span class="marca">Gestión de Cultivos · Trabajador</span>
+            <a href="index.html">Inicio</a>
+        </header>
+        <main class="pagina">
+            <nav class="menu-trabajador" aria-label="Secciones del trabajador">
+                <a href="cultivos.html">Cultivos activos</a>
+                <a href="inventario.html" aria-current="page">Inventario</a>
+                <a href="observaciones.html">Observaciones</a>
+                <a href="riegos.html">Riego</a>
+                <a href="fertilizantes.html">Fertilizantes</a>
+                <a href="abonos.html">Abono</a>
+                <a href="terrenos.html">Terreno</a>
+                <a href="calendario.html">Calendario</a>
+            </nav>
+            <h1>Inventario</h1>
+            <nav class="menu-trabajador" aria-label="Contenido del inventario">
+                <a href="inventario.html">Existencias</a>
+                <a href="inventario.html?seccion=semillas">Semillas</a>
+            </nav>
+            <p id="mensaje-operacion" class="mensaje" role="status"></p>
+            <section class="panel">
+                <h2>Registrar o actualizar</h2>
+                <form id="formulario-operacion" data-ruta="/inventario" data-id="idInventario" novalidate>
+                    <div class="campos-operacion">
+                        <div>
+                            <label for="idInsumo">Insumo</label>
+                            <select id="idInsumo" name="idInsumo" data-ruta="/insumos" data-id="idInsumo" data-nombre="nombre" data-numero="true" required></select>
+                        </div>
+                        <div>
+                            <label for="cantidad">Cantidad</label>
+                            <input id="cantidad" name="cantidad" type="number" required min="0" step="0.01">
+                        </div>
+                        <div>
+                            <label for="fechaIngreso">Fecha de ingreso</label>
+                            <input id="fechaIngreso" name="fechaIngreso" type="date" required>
+                        </div>
+                        <div>
+                            <label for="fechaCaducidad">Caducidad</label>
+                            <input id="fechaCaducidad" name="fechaCaducidad" type="date">
+                        </div>
+                    </div>
+                    <div class="acciones-operacion">
+                        <button id="guardar-operacion" class="boton" type="submit">Guardar</button>
+                        <button id="cancelar-operacion" class="boton boton-secundario" type="button">Cancelar edición</button>
+                    </div>
+                </form>
+            </section>
+            <section class="panel espacio">
+                <h2>Registros</h2>
+                <button id="actualizar-operacion" class="boton boton-secundario" type="button">Actualizar</button>
+                <div class="tabla-contenedor espacio">
+                    <table>
+                        <thead>
+                            <tr>
+                                <th data-campo="idInsumo">Insumo</th>
+                                <th data-campo="categoria">Categoría</th>
+                                <th data-campo="cantidad">Cantidad</th>
+                                <th data-campo="unidadMedida">Unidad</th>
+                                <th data-campo="fechaIngreso">Ingreso</th>
+                                <th data-campo="fechaCaducidad">Caducidad</th>
+                                <th>Acciones</th>
+                            </tr>
+                        </thead>
+                        <tbody id="registros-operacion"></tbody>
+                    </table>
+                </div>
+            </section>
+        </main>
+        <script src="js/api.js"></script>
+        <script src="js/proveedores.js"></script>
+        <script src="js/inventario.js"></script>
+        <script src="js/operaciones.js"></script>
+    </body>
+</html>
diff --git a/frontend/js/inventario.js b/frontend/js/inventario.js
new file mode 100644
index 0000000..c3904ea
--- /dev/null
+++ b/frontend/js/inventario.js
@@ -0,0 +1,26 @@
+// Las semillas se administran dentro del inventario.
+var seccionInventario = new URLSearchParams(window.location.search).get('seccion');
+if (seccionInventario === 'semillas') {
+    document.querySelector('h1').textContent = 'Inventario · Semillas';
+    var formularioSemillas = document.getElementById('formulario-operacion');
+    formularioSemillas.dataset.ruta = '/semillas';
+    formularioSemillas.dataset.id = 'id';
+    formularioSemillas.querySelector('.campos-operacion').innerHTML = `
+        <div>
+            <label for="nombre">Nombre de la semilla</label>
+            <input id="nombre" name="nombre" type="text" maxlength="100" required>
+        </div>
+        <div>
+            <label for="unidadMedida">Unidad de medida</label>
+            <input id="unidadMedida" name="unidadMedida" type="text" maxlength="20" required>
+        </div>
+        <div>
+            <label for="proveedorNombre">Proveedor</label>
+            <input id="proveedorNombre" name="proveedorNombre" type="text" maxlength="100" required>
+        </div>`;
+    document.querySelector('thead tr').innerHTML = `
+        <th data-campo="nombre">Semilla</th>
+        <th data-campo="unidadMedida">Unidad</th>
+        <th data-campo="idProveedor">Proveedor</th>
+        <th>Acciones</th>`;
+}
