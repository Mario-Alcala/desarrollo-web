+<!DOCTYPE html>
+<html lang="es">
+    <head>
+        <meta charset="UTF-8">
+        <meta name="viewport" content="width=device-width, initial-scale=1.0">
+        <title>Calendario de cultivos</title>
+        <link rel="stylesheet" href="css/styles.css">
+        <link rel="stylesheet" href="css/cultivos.css">
+        <link rel="stylesheet" href="css/calendario.css">
+    </head>
+    <body>
+        <header class="barra">
+            <span class="marca">Gestión de Cultivos · Trabajador</span>
+            <nav aria-label="Navegación del trabajador">
+                <a href="index.html">Inicio</a>
+                <a href="cultivos.html">Cultivos activos</a>
+            </nav>
+        </header>
+        <main class="pagina calendario">
+<h1>Programar etapa</h1>
+<a href="calendario.html">Regresar al calendario</a>
+<div class="filtros-calendario">
+                <div>
+                    <label for="filtro-cultivo">Cultivo</label>
+                    <select id="filtro-cultivo">
+                        <option value="">Todos los cultivos</option>
+                    </select>
+                </div>
+            </div>
+            <p id="mensaje-etapa" class="mensaje" role="status"></p>
+<section class="panel espacio">
+                <h2>Programar una etapa o tarea</h2>
+                <p>Las fechas y tareas se guardan en este navegador.</p>
+                <form id="formulario-etapa" novalidate>
+                    <div class="campos-operacion">
+                        <div>
+                            <label for="cultivo">Cultivo</label>
+                            <select id="cultivo" required></select>
+                        </div>
+                        <div>
+                            <label for="etapa">Etapa</label>
+                            <select id="etapa" required>
+                                <option value="">Selecciona una etapa</option>
+                                <option>Germinación</option>
+                                <option>Siembra</option>
+                                <option>Vegetación/Riego</option>
+                                <option>Floración</option>
+                                <option>Cosecha</option>
+                            </select>
+                        </div>
+                        <div>
+                            <label for="fecha-inicio">Inicio de etapa / siembra</label>
+                            <input id="fecha-inicio" type="date" required>
+                        </div>
+                        <div>
+                            <label for="fecha-cosecha">Cosecha estimada</label>
+                            <input id="fecha-cosecha" type="date" required>
+                        </div>
+                    </div>
+                    <label for="notas">Notas de tarea</label>
+                    <textarea id="notas" rows="3" maxlength="500" placeholder="Riego, fertilizante o cuidados de la planta"></textarea>
+                    <button id="guardar-etapa" class="boton espacio" type="submit">Guardar etapa</button>
+                </form>
+            </section>
+</main>
+<script src="js/datos.js"></script>
+        <script src="js/calendario.js"></script>
+    </body>
+</html>
