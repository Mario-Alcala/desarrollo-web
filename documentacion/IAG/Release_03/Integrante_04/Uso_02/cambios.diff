diff --git a/frontend/calendario.html b/frontend/calendario.html
new file mode 100644
index 0000000..44656f8
--- /dev/null
+++ b/frontend/calendario.html
@@ -0,0 +1,70 @@
+<!DOCTYPE html>
+<html lang="es">
+    <head>
+        <meta charset="UTF-8">
+        <meta name="viewport" content="width=device-width, initial-scale=1.0">
+        <title>Calendario de cultivos</title>
+        <link rel="stylesheet" href="css/styles.css">
+        <link rel="stylesheet" href="css/cultivos.css">
+        <link rel="stylesheet" href="css/calendario.css">
+    </head>
+    <body>
+        <header class="barra">
+            <span class="marca">Gestión de Cultivos · Trabajador</span>
+            <nav aria-label="Navegación del trabajador">
+                <a href="index.html">Inicio</a>
+                <a href="cultivos.html">Cultivos activos</a>
+            </nav>
+        </header>
+        <main class="pagina calendario">
+            <h1>Calendario de cultivos</h1>
+            <p>Consulta las etapas y las próximas tareas de tus cultivos.</p>
+            <div class="filtros-calendario">
+                <div>
+                    <label for="filtro-cultivo">Cultivo</label>
+                    <select id="filtro-cultivo">
+                        <option value="">Todos los cultivos</option>
+                    </select>
+                </div>
+            </div>
+            <p id="mensaje-etapa" class="mensaje" role="status"></p>
+            <div id="cultivos-seguimiento" class="cultivos-seguimiento" aria-label="Estado de los cultivos"></div>
+            <div class="leyenda">
+                <span class="germinacion">Germinación</span>
+                <span class="siembra">Siembra</span>
+                <span class="riego">Vegetación / Riego</span>
+                <span class="floracion">Floración</span>
+                <span class="cosecha">Cosecha</span>
+            </div>
+            <section class="panel espacio" aria-label="Calendario mensual">
+                <div class="cabecera-mes">
+                    <button id="mes-anterior" class="boton boton-secundario" aria-label="Mes anterior" type="button">←</button>
+                    <h2 id="titulo-mes" aria-live="polite"></h2>
+                    <button id="mes-siguiente" class="boton boton-secundario" aria-label="Mes siguiente" type="button">→</button>
+                    <button id="mes-actual" class="boton boton-secundario" type="button">Hoy</button>
+                </div>
+                <div class="calendario-scroll">
+                    <div class="semana" aria-hidden="true">
+                        <span>Lun</span>
+                        <span>Mar</span>
+                        <span>Mié</span>
+                        <span>Jue</span>
+                        <span>Vie</span>
+                        <span>Sáb</span>
+                        <span>Dom</span>
+                    </div>
+                    <div id="dias-calendario" class="dias-calendario"></div>
+                </div>
+            </section>
+            <section class="panel espacio">
+                <div class="cabecera-mes">
+                    <h2 id="titulo-tareas">Etapas programadas</h2>
+                </div>
+                <div id="tareas-calendario"></div>
+            </section>
+            <a class="boton espacio" href="etapas.html">Programar una etapa</a>
+        </main>
+        <script src="js/datos.js"></script>
+        <script src="js/calendario.js"></script>
+    </body>
+</html>
diff --git a/frontend/css/calendario.css b/frontend/css/calendario.css
new file mode 100644
index 0000000..ec7139f
--- /dev/null
+++ b/frontend/css/calendario.css
@@ -0,0 +1,211 @@
+.filtros-calendario {
+    display: flex;
+    align-items: end;
+    flex-wrap: wrap;
+    gap: 20px;
+}
+
+.filtros-calendario > div {
+    flex: 1;
+    min-width: 200px;
+}
+
+.calendario label {
+    display: block;
+}
+
+.cultivos-seguimiento {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 12px;
+    margin-bottom: 24px;
+}
+
+.cultivo-seguimiento {
+    background: white;
+    border: 1px solid #d4dfcf;
+    padding: 12px 16px;
+    border-radius: 6px;
+}
+
+.cultivo-seguimiento p {
+    margin: 6px 0;
+}
+
+.cabecera-mes {
+    display: flex;
+    gap: 16px;
+    align-items: center;
+    flex-wrap: wrap;
+    margin-bottom: 20px;
+}
+
+.cabecera-mes h2 {
+    margin: 0;
+    flex: 1;
+    text-transform: capitalize;
+}
+
+.calendario-scroll {
+    overflow-x: auto;
+}
+
+.semana,
+.dias-calendario {
+    display: grid;
+    grid-template-columns: repeat(7, minmax(0, 1fr));
+    min-width: 630px;
+}
+
+.semana span {
+    text-align: center;
+    padding: 12px;
+    background: #e4eedd;
+    font-weight: bold;
+}
+
+.dia {
+    min-height: 125px;
+    border: 1px solid #d4dfcf;
+    padding: 8px;
+}
+
+.dia-vacio {
+    background: #f4f8f1;
+}
+
+.dia > button {
+    border: 0;
+    background: transparent;
+    color: #1f2d1f;
+    font: inherit;
+    cursor: pointer;
+    padding: 5px 10px;
+    border-radius: 4px;
+}
+
+.dia.hoy > button {
+    background: #2e6b2e;
+    color: white;
+}
+
+.dia.seleccionado {
+    outline: 2px solid #2e6b2e;
+    outline-offset: -2px;
+}
+
+.marca-etapa {
+    display: block;
+    font-size: 12px;
+    padding: 5px;
+    margin-top: 5px;
+    border-radius: 4px;
+    overflow-wrap: anywhere;
+}
+
+.leyenda {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 12px;
+}
+
+.leyenda span {
+    padding: 8px 12px;
+    border-radius: 4px;
+    font-size: 14px;
+}
+
+.germinacion {
+    background: #e1efc8;
+    color: #354b13;
+}
+
+.siembra {
+    background: #f1e4d1;
+    color: #604323;
+}
+
+.riego {
+    background: #d8edf7;
+    color: #1e536c;
+}
+
+.floracion {
+    background: #f5deec;
+    color: #78345c;
+}
+
+.cosecha {
+    background: #faebbf;
+    color: #695009;
+}
+
+.marca-etapa.completada {
+    border-left: 4px solid #2e6b2e;
+}
+
+.tarea {
+    padding: 18px 0;
+    border-bottom: 1px solid #d4dfcf;
+}
+
+.tarea h3 {
+    margin: 0 0 8px;
+}
+
+.tarea p {
+    margin: 8px 0;
+    white-space: pre-wrap;
+    overflow-wrap: anywhere;
+}
+
+.tarea .boton {
+    margin-right: 10px;
+}
+
+summary {
+    cursor: pointer;
+    font-size: 20px;
+    font-weight: bold;
+    color: #2e6b2e;
+}
+
+#guardar-etapa {
+    align-self: flex-start;
+}
+
+@media (max-width: 600px) {
+    .cabecera-mes {
+        gap: 8px;
+    }
+
+    .cabecera-mes h2 {
+        font-size: 19px;
+    }
+}
+/* Campos de la programación de etapas. */
+.calendario .campos-operacion {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 0 24px;
+}
+
+.calendario select,
+.calendario textarea {
+    width: 100%;
+    padding: 12px;
+    border: 1px solid #9caa96;
+    border-radius: 5px;
+    font: inherit;
+    background: white;
+}
+
+.calendario textarea {
+    resize: vertical;
+}
+
+@media (max-width: 600px) {
+    .calendario .campos-operacion {
+        grid-template-columns: 1fr;
+    }
+}
diff --git a/frontend/etapas.html b/frontend/etapas.html
new file mode 100644
index 0000000..95cd0c6
--- /dev/null
+++ b/frontend/etapas.html
@@ -0,0 +1,69 @@
+<!DOCTYPE html>
+<html lang="es">
+    <head>
+        <meta charset="UTF-8">
+        <meta name="viewport" content="width=device-width, initial-scale=1.0">
+        <title>Calendario de cultivos</title>
+        <link rel="stylesheet" href="css/styles.css">
+        <link rel="stylesheet" href="css/cultivos.css">
+        <link rel="stylesheet" href="css/calendario.css">
+    </head>
+    <body>
+        <header class="barra">
+            <span class="marca">Gestión de Cultivos · Trabajador</span>
+            <nav aria-label="Navegación del trabajador">
+                <a href="index.html">Inicio</a>
+                <a href="cultivos.html">Cultivos activos</a>
+            </nav>
+        </header>
+        <main class="pagina calendario">
+<h1>Programar etapa</h1>
+<a href="calendario.html">Regresar al calendario</a>
+<div class="filtros-calendario">
+                <div>
+                    <label for="filtro-cultivo">Cultivo</label>
+                    <select id="filtro-cultivo">
+                        <option value="">Todos los cultivos</option>
+                    </select>
+                </div>
+            </div>
+            <p id="mensaje-etapa" class="mensaje" role="status"></p>
+<section class="panel espacio">
+                <h2>Programar una etapa o tarea</h2>
+                <p>Las fechas y tareas se guardan en este navegador.</p>
+                <form id="formulario-etapa" novalidate>
+                    <div class="campos-operacion">
+                        <div>
+                            <label for="cultivo">Cultivo</label>
+                            <select id="cultivo" required></select>
+                        </div>
+                        <div>
+                            <label for="etapa">Etapa</label>
+                            <select id="etapa" required>
+                                <option value="">Selecciona una etapa</option>
+                                <option>Germinación</option>
+                                <option>Siembra</option>
+                                <option>Vegetación/Riego</option>
+                                <option>Floración</option>
+                                <option>Cosecha</option>
+                            </select>
+                        </div>
+                        <div>
+                            <label for="fecha-inicio">Inicio de etapa / siembra</label>
+                            <input id="fecha-inicio" type="date" required>
+                        </div>
+                        <div>
+                            <label for="fecha-cosecha">Cosecha estimada</label>
+                            <input id="fecha-cosecha" type="date" required>
+                        </div>
+                    </div>
+                    <label for="notas">Notas de tarea</label>
+                    <textarea id="notas" rows="3" maxlength="500" placeholder="Riego, fertilizante o cuidados de la planta"></textarea>
+                    <button id="guardar-etapa" class="boton espacio" type="submit">Guardar etapa</button>
+                </form>
+            </section>
+</main>
+<script src="js/datos.js"></script>
+        <script src="js/calendario.js"></script>
+    </body>
+</html>
diff --git a/frontend/js/calendario.js b/frontend/js/calendario.js
new file mode 100644
index 0000000..34a3d5a
--- /dev/null
+++ b/frontend/js/calendario.js
@@ -0,0 +1,301 @@
+var claveCalendario = 'gestion-cultivos-calendario';
+var fechaVista = new Date();
+var fechaEnlace = new URLSearchParams(window.location.search).get('fecha');
+if (fechaEnlace && /^\d{4}-\d{2}-\d{2}$/.test(fechaEnlace)) {
+    var partesFecha = fechaEnlace.split('-');
+    fechaVista = new Date(Number(partesFecha[0]), Number(partesFecha[1]) - 1, 1);
+}
+var diaElegido = '';
+var cultivosCalendario = [];
+var filtroCultivo = document.getElementById('filtro-cultivo');
+var cultivoSeleccionado = document.getElementById('cultivo');
+var mensajeEtapa = document.getElementById('mensaje-etapa');
+var formularioEtapa = document.getElementById('formulario-etapa');
+var numeroCarga = 0;
+
+function leerCalendario() {
+    var datos = localStorage.getItem(claveCalendario);
+    return datos ? JSON.parse(datos) : {
+        siguienteId: 1, eventos: []
+    };
+}
+function guardarCalendario(datos) {
+    localStorage.setItem(claveCalendario, JSON.stringify(datos));
+}
+function fechaTexto(fecha) {
+    return fecha.getFullYear() + '-' + String(fecha.getMonth() + 1).padStart(2, '0') + '-' + String(fecha.getDate()).padStart(2, '0');
+}
+function colorEtapa(etapa) {
+    if (etapa === 'Germinación') {
+        return 'germinacion';
+    }
+    if (etapa === 'Siembra') {
+        return 'siembra';
+    }
+    if (etapa === 'Floración') {
+        return 'floracion';
+    }
+    if (etapa === 'Cosecha') {
+        return 'cosecha';
+    }
+    return 'riego';
+}
+function eventosVisibles() {
+    return leerCalendario().eventos.filter(function (evento) {
+        return (evento.origen || 'local') === 'local' && (!filtroCultivo.value || String(evento.cultivoId) === filtroCultivo.value);
+    });
+}
+function consultarCultivosBackend() {
+    return fetch('http://localhost:8080/api/cultivos').then(function (respuesta) {
+        if (!respuesta.ok) {
+            throw new Error('No se pudieron consultar los cultivos.');
+        }
+        return respuesta.json();
+    });
+}
+
+function cargarCultivosCalendario() {
+    var cargaActual = ++numeroCarga;
+    if (formularioEtapa) { document.getElementById('guardar-etapa').disabled = true; }
+    mensajeEtapa.textContent = '';
+    var consulta;
+    try {
+        // Por ahora los cultivos se cargan siempre desde los datos locales.
+        consulta = Promise.resolve(leerDatos().productos);
+    } catch (error) {
+        mensajeEtapa.textContent = error.message;
+        return;
+    }
+    consulta.then(function (cultivos) {
+        if (cargaActual !== numeroCarga) {
+            return;
+        }
+        cultivosCalendario = cultivos || [];
+        mostrarSeguimiento();
+        var anterior = filtroCultivo.value;
+        filtroCultivo.innerHTML = '<option value="">Todos los cultivos</option>';
+        if (cultivoSeleccionado) { cultivoSeleccionado.innerHTML = '<option value="">Selecciona un cultivo</option>'; }
+        cultivosCalendario.forEach(function (cultivo) {
+            [filtroCultivo, cultivoSeleccionado].forEach(function (select) {
+                if (!select) { return; }
+                var opcion = document.createElement('option');
+                opcion.value = cultivo.id;
+                opcion.textContent = cultivo.nombre + (cultivo.etapaFenologica ? ' · ' + cultivo.etapaFenologica : '');
+                select.appendChild(opcion);
+            });
+        });
+        filtroCultivo.value = anterior;
+        if (formularioEtapa) { document.getElementById('guardar-etapa').disabled = !cultivosCalendario.length; }
+        mensajeEtapa.textContent = cultivosCalendario.length ? '' : 'No hay cultivos registrados.';
+        dibujarCalendario();
+    }).catch(function (error) {
+        if (cargaActual !== numeroCarga) {
+            return;
+        }
+        cultivosCalendario = [];
+        mostrarSeguimiento();
+        if (cultivoSeleccionado) { cultivoSeleccionado.innerHTML = '<option value="">Sin conexión</option>'; }
+        mensajeEtapa.textContent = '';
+        dibujarCalendario();
+    });
+}
+
+function mostrarSeguimiento() {
+    var lista = document.getElementById('cultivos-seguimiento');
+    if (!lista) { return; }
+    lista.innerHTML = '';
+    cultivosCalendario.forEach(function (cultivo) {
+        var tarjeta = document.createElement('div');
+        tarjeta.className = 'cultivo-seguimiento';
+        var nombre = document.createElement('strong');
+        nombre.textContent = cultivo.nombre;
+        var etapa = document.createElement('p');
+        etapa.textContent = 'Etapa actual: ' + (cultivo.etapaFenologica || 'Por programar');
+        tarjeta.appendChild(nombre);
+        tarjeta.appendChild(etapa);
+        lista.appendChild(tarjeta);
+    });
+}
+
+function dibujarCalendario() {
+    if (!document.getElementById('dias-calendario')) { return; }
+    try {
+        var eventos = eventosVisibles();
+        var contenedor = document.getElementById('dias-calendario');
+        contenedor.innerHTML = '';
+        var anio = fechaVista.getFullYear();
+        var mes = fechaVista.getMonth();
+        document.getElementById('titulo-mes').textContent = fechaVista.toLocaleDateString('es-MX', { month: 'long', year: 'numeric' });
+        var comienzo = (new Date(anio, mes, 1).getDay() + 6) % 7;
+        var dias = new Date(anio, mes + 1, 0).getDate();
+        var espacios = Math.ceil((comienzo + dias) / 7) * 7;
+        for (var i = 0; i < espacios; i++) {
+            var casilla = document.createElement('div');
+            casilla.className = 'dia';
+            if (i < comienzo || i >= comienzo + dias) {
+                casilla.classList.add('dia-vacio');
+            } else {
+                var numero = i - comienzo + 1;
+                var fecha = fechaTexto(new Date(anio, mes, numero));
+                var boton = document.createElement('button');
+                boton.textContent = numero;
+                boton.dataset.fecha = fecha;
+                boton.setAttribute('aria-label', 'Ver tareas del ' + fecha);
+                boton.onclick = function () {
+                    diaElegido = this.dataset.fecha;
+                    dibujarCalendario();
+                };
+                casilla.appendChild(boton);
+                if (fecha === fechaTexto(new Date())) {
+                    casilla.classList.add('hoy');
+                }
+                if (fecha === diaElegido) {
+                    casilla.classList.add('seleccionado');
+                }
+                eventos.forEach(function (evento) {
+                    if (evento.inicio === fecha) {
+                        agregarMarca(casilla, evento, evento.etapa);
+                    }
+                    if (evento.cosecha === fecha && (evento.etapa !== 'Cosecha' || evento.inicio !== fecha)) {
+                        agregarMarca(casilla, evento, 'Cosecha estimada');
+                    }
+                });
+            }
+            contenedor.appendChild(casilla);
+        }
+        mostrarTareas(eventos);
+    } catch (error) {
+        mensajeEtapa.textContent = 'No se pudo leer el calendario guardado.';
+    }
+}
+function agregarMarca(casilla, evento, etiqueta) {
+    var marca = document.createElement('span');
+    marca.className = 'marca-etapa ' + colorEtapa(etiqueta === 'Cosecha estimada' ? 'Cosecha' : evento.etapa);
+    if (evento.completada && etiqueta !== 'Cosecha estimada') {
+        marca.classList.add('completada');
+    }
+    marca.textContent = evento.cultivoNombre + ' · ' + etiqueta + (evento.completada && etiqueta !== 'Cosecha estimada' ? ' ✓' : '');
+    casilla.appendChild(marca);
+}
+function mostrarTareas(eventos) {
+    var lista = document.getElementById('tareas-calendario');
+    lista.innerHTML = '';
+    document.getElementById('titulo-tareas').textContent = 'Etapas programadas';
+    eventos.sort(function (a, b) { return a.inicio.localeCompare(b.inicio) || a.id - b.id; });
+    if (!eventos.length) {
+        lista.textContent = 'No hay tareas programadas para esta selección.';
+    }
+    eventos.forEach(function (evento) {
+        var bloque = document.createElement('article');
+        bloque.className = 'tarea';
+        var titulo = document.createElement('h3');
+        titulo.textContent = evento.cultivoNombre + ' · ' + evento.etapa;
+        var fechas = document.createElement('p');
+        fechas.textContent = 'Inicio: ' + evento.inicio + ' · Cosecha estimada: ' + evento.cosecha;
+        var notas = document.createElement('p');
+        notas.textContent = (evento.completada ? 'Completada. ' : 'Pendiente. ') + (evento.notas || 'Sin notas.');
+        var completar = document.createElement('button');
+        completar.className = 'boton boton-secundario';
+        completar.textContent = 'Completar';
+        completar.disabled = evento.completada;
+        completar.onclick = function () {
+            cambiarEvento(evento.id, false);
+        };
+        var eliminar = document.createElement('button');
+        eliminar.className = 'boton boton-secundario';
+        eliminar.textContent = 'Eliminar';
+        eliminar.onclick = function () { if (confirm('¿Eliminar esta etapa?')) { cambiarEvento(evento.id, true); } };
+        bloque.appendChild(titulo);
+        bloque.appendChild(fechas);
+        bloque.appendChild(notas);
+        bloque.appendChild(completar);
+        bloque.appendChild(eliminar);
+        lista.appendChild(bloque);
+    });
+}
+function cambiarEvento(id, eliminar) {
+    try {
+        var datos = leerCalendario();
+        if (eliminar) { datos.eventos = datos.eventos.filter(function (evento) { return evento.id !== id; }); }
+        else { datos.eventos.forEach(function (evento) { if (evento.id === id) { evento.completada = true; } }); }
+        guardarCalendario(datos);
+        dibujarCalendario();
+        mensajeEtapa.textContent = eliminar ? 'Etapa eliminada.' : 'Etapa completada.';
+    } catch (error) {
+        mensajeEtapa.textContent = 'No se pudo guardar el cambio.';
+    }
+}
+if (formularioEtapa) {
+formularioEtapa.addEventListener('submit', function (evento) {
+    evento.preventDefault();
+    var inicio = document.getElementById('fecha-inicio').value;
+    var cosecha = document.getElementById('fecha-cosecha').value;
+    if (!inicio || !cosecha) {
+        mensajeEtapa.textContent = 'Completa ambas fechas.';
+        return;
+    }
+    if (cosecha < inicio) {
+        mensajeEtapa.textContent = 'La cosecha no puede ser anterior al inicio o siembra.';
+        return;
+    }
+    if (!formularioEtapa.reportValidity()) {
+        return;
+    }
+    var cultivo = null;
+    cultivosCalendario.forEach(function (actual) { if (String(actual.id) === cultivoSeleccionado.value) { cultivo = actual; } });
+    if (!cultivo) {
+        mensajeEtapa.textContent = 'Actualiza y selecciona un cultivo disponible.';
+        return;
+    }
+    try {
+        var datos = leerCalendario();
+        datos.eventos.push({ id: datos.siguienteId++, origen: 'local', cultivoId: cultivo.id, cultivoNombre: cultivo.nombre,
+            etapa: document.getElementById('etapa').value, inicio: inicio, cosecha: cosecha,
+            notas: document.getElementById('notas').value.trim(), completada: false });
+        guardarCalendario(datos);
+        var partes = inicio.split('-');
+        fechaVista = new Date(Number(partes[0]), Number(partes[1]) - 1, 1);
+        diaElegido = inicio;
+        filtroCultivo.value = String(cultivo.id);
+        formularioEtapa.reset();
+        dibujarCalendario();
+        window.location.href = 'calendario.html?fecha=' + inicio;
+    } catch (error) {
