diff --git a/frontend/js/historial.js b/frontend/js/historial.js
new file mode 100644
index 0000000..bc0e013
--- /dev/null
+++ b/frontend/js/historial.js
@@ -0,0 +1,36 @@
+function mostrarHistorial() {
+    var cuerpo = document.getElementById('historial-pedidos');
+    var mensaje = document.getElementById('mensaje-historial');
+    cuerpo.innerHTML = '';
+    mensaje.textContent = '';
+
+    try {
+        var pedidos = leerDatos().pedidos;
+        // Los pedidos más recientes aparecen primero.
+        for (var i = pedidos.length - 1; i >= 0; i--) {
+            var pedido = pedidos[i];
+            var fecha = pedido.fecha ? pedido.fecha.split(',')[0] : '—';
+            pedido.productos.forEach(function (producto) {
+                var fila = document.createElement('tr');
+                agregarCelda(fila, producto.nombre);
+                agregarCelda(fila, producto.kilos + ' kg');
+                agregarCelda(fila, fecha);
+                agregarCelda(fila, pedido.tipoEntrega || 'No especificado');
+                cuerpo.appendChild(fila);
+            });
+        }
+        if (pedidos.length === 0) {
+            mensaje.textContent = 'Todavía no tienes pedidos.';
+        }
+    } catch (error) {
+        mensaje.textContent = 'No se pudo consultar el historial.';
+    }
+}
+
+window.addEventListener('storage', function (evento) {
+    if (evento.key === claveDatos || evento.key === null) {
+        mostrarHistorial();
+    }
+});
+window.addEventListener('pageshow', mostrarHistorial);
+mostrarHistorial();
diff --git a/frontend/js/pago.js b/frontend/js/pago.js
new file mode 100644
index 0000000..8a1a23b
--- /dev/null
+++ b/frontend/js/pago.js
@@ -0,0 +1,134 @@
+var formularioPago = document.getElementById('formulario-pago');
+var mensajePago = document.getElementById('mensaje-pago');
+var productosPago = [];
+var totalPago = 0;
+
+function revisarPedido() {
+    var borrador = leerBorrador();
+    var datos = leerDatos();
+    var productos = [];
+    for (var id in borrador.cantidades) {
+        var kilos = borrador.cantidades[id];
+        var producto = buscarProducto(datos, Number(id));
+        if (!producto || !Number.isInteger(kilos) || kilos <= 0 || kilos > producto.stock) {
+            throw new Error('El pedido cambió o no hay suficientes kilos. Regresa al catálogo para revisarlo.');
+        }
+        productos.push({ id: producto.id, nombre: producto.nombre, kilos: kilos, precio: producto.precio });
+    }
+    if (!productos.length) {
+        throw new Error('No tienes productos seleccionados. Regresa al catálogo.');
+    }
+    return productos;
+}
+
+function mostrarPago() {
+    try {
+        productosPago = revisarPedido();
+        var cuerpo = document.getElementById('resumen-pago');
+        cuerpo.innerHTML = '';
+        var centavos = 0;
+        productosPago.forEach(function (producto) {
+            var subtotal = Math.round(producto.precio * 100) * producto.kilos;
+            centavos += subtotal;
+            var fila = document.createElement('tr');
+            agregarCelda(fila, producto.nombre);
+            agregarCelda(fila, producto.kilos);
+            agregarCelda(fila, dinero(subtotal / 100));
+            cuerpo.appendChild(fila);
+        });
+        totalPago = centavos / 100;
+        document.getElementById('total-pago').textContent = dinero(totalPago);
+        var fecha = leerBorrador().fechaRecoleccion;
+        document.getElementById('fecha-elegida').textContent = fechaPermitida(fecha) ? 'Día de recolección: ' + fecha : 'Selecciona el día de recolección.';
+        document.getElementById('vencimiento').min = fechaLocal(new Date()).slice(0, 7);
+        document.getElementById('confirmar-pago').disabled = false;
+        return true;
+    } catch (error) {
+        mensajePago.textContent = error.message;
+        document.getElementById('confirmar-pago').disabled = true;
+        return false;
+    }
+}
+
+document.getElementById('recoleccion').onclick = function () {
+    if (mostrarPago()) {
+        window.location.href = 'recoleccion.html';
+    }
+};
+
+formularioPago.addEventListener('submit', function (evento) {
+    evento.preventDefault();
+    try {
+        var borrador = leerBorrador();
+        if (!fechaPermitida(borrador.fechaRecoleccion)) {
+            mensajePago.textContent = 'Selecciona una fecha válida con el botón Recolección.';
+            return;
+        }
+        document.getElementById('titular').value = document.getElementById('titular').value.trim();
+        document.getElementById('vencimiento').min = fechaLocal(new Date()).slice(0, 7);
+        if (!formularioPago.reportValidity()) {
+            return;
+        }
+        var actuales = revisarPedido();
+        if (JSON.stringify(actuales) !== JSON.stringify(productosPago)) {
+            mostrarPago();
+            mensajePago.textContent = 'Los productos o precios cambiaron. Revisa el total antes de confirmar otra vez.';
+            return;
+        }
+        document.getElementById('confirmar-pago').disabled = true;
+        var datos = leerDatos();
+        var pedido = {
+            id: datos.siguientePedido,
+            fecha: new Date().toLocaleString('es-MX'),
+            fechaRecoleccion: borrador.fechaRecoleccion,
+            tipoEntrega: 'Recolección',
+            metodoPago: document.getElementById('metodo-pago').value,
+            estado: 'Recibido (simulación)',
+            productos: actuales,
+            total: totalPago
+        };
+        actuales.forEach(function (producto) {
+            buscarProducto(datos, producto.id).stock -= producto.kilos;
+        });
+        datos.pedidos.push(pedido);
+        datos.siguientePedido++;
+        // Se guarda el pedido sin los datos de tarjeta.
+        guardarDatos(datos);
+        sessionStorage.removeItem(claveBorrador);
+        formularioPago.reset();
+        document.getElementById('contenido-pago').hidden = true;
+        document.getElementById('confirmacion-pedido').hidden = false;
+        document.getElementById('numero-pedido').textContent = 'Número de pedido: ' + pedido.id;
+        document.getElementById('fecha-confirmada').textContent = 'Día de recolección: ' + pedido.fechaRecoleccion;
+        mensajePago.textContent = 'Pedido de prueba confirmado.';
+    } catch (error) {
+        mensajePago.textContent = error.message;
+        document.getElementById('confirmar-pago').disabled = false;
+    }
+});
+
+window.addEventListener('pageshow', function () {
+    formularioPago.reset();
+    cambiarMetodoPago();
+    if (document.getElementById('confirmacion-pedido').hidden) {
+        mostrarPago();
+    }
+});
+mostrarPago();
+
+function cambiarMetodoPago() {
+    var transferencia = document.getElementById('metodo-pago').value === 'Transferencia';
+    document.getElementById('datos-transferencia').hidden = !transferencia;
+    document.getElementById('datos-tarjeta').hidden = transferencia;
+    document.querySelectorAll('#datos-tarjeta input').forEach(function (campo) {
+        campo.disabled = transferencia;
+    });
+}
+
+document.getElementById('metodo-pago').onchange = cambiarMetodoPago;
+document.getElementById('entregar-pedido').onclick = function () {
+    document.getElementById('confirmacion-pedido').hidden = true;
+    document.getElementById('mensaje-pago').textContent = '';
+    document.getElementById('seccion-rastreo').hidden = false;
+};
+cambiarMetodoPago();
diff --git a/frontend/js/pedido.js b/frontend/js/pedido.js
new file mode 100644
index 0000000..c2cf6ab
--- /dev/null
+++ b/frontend/js/pedido.js
@@ -0,0 +1,25 @@
+var claveBorrador = 'gestion-cultivos-pedido-actual';
+
+function leerBorrador() {
+    var guardado = sessionStorage.getItem(claveBorrador);
+    return guardado ? JSON.parse(guardado) : { cantidades: {}, fechaRecoleccion: '' };
+}
+
+function guardarBorrador(borrador) {
+    sessionStorage.setItem(claveBorrador, JSON.stringify(borrador));
+}
+
+function fechaLocal(fecha) {
+    return fecha.getFullYear() + '-' + String(fecha.getMonth() + 1).padStart(2, '0') + '-' + String(fecha.getDate()).padStart(2, '0');
+}
+
+function limiteRecoleccion() {
+    var limite = new Date();
+    limite.setDate(limite.getDate() + 13);
+    return fechaLocal(limite);
+}
+
+function fechaPermitida(fecha) {
+    // Dos semanas contando el día de hoy, como en el sketch.
+    return /^\d{4}-\d{2}-\d{2}$/.test(fecha) && fecha >= fechaLocal(new Date()) && fecha <= limiteRecoleccion();
+}
diff --git a/frontend/js/recoleccion.js b/frontend/js/recoleccion.js
new file mode 100644
index 0000000..a8728b8
--- /dev/null
+++ b/frontend/js/recoleccion.js
@@ -0,0 +1,89 @@
+var fechaVista = new Date();
+var fechaElegida = '';
+var mensajeRecoleccion = document.getElementById('mensaje-recoleccion');
+
+function mostrarRecoleccion() {
+    var anio = fechaVista.getFullYear();
+    var mes = fechaVista.getMonth();
+    document.getElementById('nombre-mes').textContent = fechaVista.toLocaleDateString('es-MX', { month: 'long', year: 'numeric' });
+    var lista = document.getElementById('dias-recoleccion');
+    lista.innerHTML = '';
+    var inicio = new Date(anio, mes, 1).getDay();
+    var cantidad = new Date(anio, mes + 1, 0).getDate();
+
+    for (var espacio = 0; espacio < inicio; espacio++) {
+        lista.appendChild(document.createElement('span'));
+    }
+
+    for (var dia = 1; dia <= cantidad; dia++) {
+        var fecha = fechaLocal(new Date(anio, mes, dia));
+        var boton = document.createElement('button');
+        boton.type = 'button';
+        boton.textContent = dia;
+        boton.dataset.fecha = fecha;
+        boton.disabled = !fechaPermitida(fecha);
+        boton.setAttribute('aria-label', 'Recoger el ' + fecha);
+        boton.setAttribute('aria-pressed', fecha === fechaElegida ? 'true' : 'false');
+        if (fecha === fechaElegida) {
+            boton.className = 'elegido';
+        }
+        boton.onclick = function () {
+            fechaElegida = this.dataset.fecha;
+            mostrarRecoleccion();
+        };
+        lista.appendChild(boton);
+    }
+
+    document.getElementById('dia-seleccionado').textContent = fechaElegida ? 'Fecha seleccionada: ' + fechaElegida : 'Aún no seleccionas una fecha.';
+    document.getElementById('guardar-fecha').disabled = !fechaPermitida(fechaElegida);
+    var hoy = new Date();
+    var limite = new Date();
+    limite.setDate(limite.getDate() + 13);
+    document.getElementById('mes-anterior').disabled = anio * 12 + mes <= hoy.getFullYear() * 12 + hoy.getMonth();
+    document.getElementById('mes-siguiente').disabled = anio * 12 + mes >= limite.getFullYear() * 12 + limite.getMonth();
+}
+
+document.getElementById('mes-anterior').onclick = function () {
+    fechaVista = new Date(fechaVista.getFullYear(), fechaVista.getMonth() - 1, 1);
+    mostrarRecoleccion();
+};
+
+document.getElementById('mes-siguiente').onclick = function () {
+    fechaVista = new Date(fechaVista.getFullYear(), fechaVista.getMonth() + 1, 1);
+    mostrarRecoleccion();
+};
+
+document.getElementById('guardar-fecha').onclick = function () {
+    if (!fechaPermitida(fechaElegida)) {
+        mensajeRecoleccion.textContent = 'Selecciona una fecha disponible.';
+        return;
+    }
+    try {
+        var borrador = leerBorrador();
+        if (!Object.keys(borrador.cantidades).length) {
+            mensajeRecoleccion.textContent = 'Primero selecciona productos en el catálogo.';
+            return;
+        }
+        borrador.fechaRecoleccion = fechaElegida;
+        guardarBorrador(borrador);
+        window.location.href = 'pago.html';
+    } catch (error) {
+        mensajeRecoleccion.textContent = 'No se pudo guardar la fecha.';
+    }
+};
+
+try {
+    var borradorRecoleccion = leerBorrador();
+    if (!Object.keys(borradorRecoleccion.cantidades).length) {
+        window.location.replace('catalogo.html');
+    } else {
+        fechaElegida = fechaPermitida(borradorRecoleccion.fechaRecoleccion) ? borradorRecoleccion.fechaRecoleccion : '';
+        if (fechaElegida) {
+            var partes = fechaElegida.split('-');
+            fechaVista = new Date(Number(partes[0]), Number(partes[1]) - 1, 1);
+        }
+        mostrarRecoleccion();
+    }
+} catch (error) {
+    mensajeRecoleccion.textContent = 'No se pudo consultar el pedido.';
+}
