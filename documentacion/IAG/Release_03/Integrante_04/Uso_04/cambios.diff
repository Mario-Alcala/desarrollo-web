diff --git a/frontend/css/pago.css b/frontend/css/pago.css
new file mode 100644
index 0000000..8111b86
--- /dev/null
+++ b/frontend/css/pago.css
@@ -0,0 +1,90 @@
+.vista-pago {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 24px;
+    align-items: start;
+}
+
+.campos-tarjeta {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 20px;
+}
+
+.campos-tarjeta label {
+    display: block;
+}
+
+.acciones-pago {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 12px;
+    margin-top: 24px;
+}
+
+.pagina-recoleccion {
+    max-width: 760px;
+}
+
+.mes-recoleccion {
+    display: flex;
+    align-items: center;
+    justify-content: space-between;
+    gap: 12px;
+    margin-bottom: 20px;
+}
+
+.mes-recoleccion h2 {
+    margin: 0;
+    text-align: center;
+}
+
+.semana-recoleccion, .dias-recoleccion {
+    display: grid;
+    grid-template-columns: repeat(7, minmax(0, 1fr));
+    gap: 4px;
+}
+
+.semana-recoleccion span {
+    text-align: center;
+    padding: 10px 0;
+    font-weight: bold;
+}
+
+.dias-recoleccion button {
+    min-height: 54px;
+    border: 1px solid #9caa96;
+    border-radius: 5px;
+    background: #e4eedd;
+    color: #1f2d1f;
+    font: inherit;
+    cursor: pointer;
+}
+
+.dias-recoleccion button:disabled {
+    background: #eee;
+    color: #666;
+    cursor: not-allowed;
+}
+
+.dias-recoleccion button.elegido {
+    background: #2e6b2e;
+    color: white;
+}
+
+@media (max-width: 700px) {
+    .vista-pago {
+        grid-template-columns: 1fr;
+    }
+
+    .semana-recoleccion span {
+        font-size: 13px;
+    }
+}
+
+#metodo-pago {
+    width: 100%;
+    padding: 12px;
+    margin-bottom: 20px;
+    font: inherit;
+}
