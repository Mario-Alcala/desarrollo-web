+
+            <main class="pagina">
+                <div class="encabezado-terrenos">
+                    <div>
+                        <h1>Terrenos</h1>
+                        <p>Consulta los terrenos y abre uno para ver sus parcelas.</p>
+                    </div>
+                    <button id="agregar-terreno" class="boton" type="button">Agregar terreno</button>
+                </div>
+
+                <p id="mensaje-terrenos" class="mensaje" role="status"></p>
+                <section aria-label="Terrenos registrados">
+                    <div id="lista-terrenos" class="lista-terrenos"></div>
+                </section>
+            </main>
+        </div>
+    </div>
+
+    <dialog id="dialogo-terreno" aria-labelledby="titulo-dialogo">
