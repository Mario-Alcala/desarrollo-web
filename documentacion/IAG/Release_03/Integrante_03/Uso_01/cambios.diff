+<!DOCTYPE html>
+
+<!--
+  ARCHIVO: terrenos.html
+  CAPA: FRONTEND
+  BACKEND: la lista sale de la API /api/terrenos (lo conecta js/terrenos.js).
+  LE FALTA: versión con fichas escritas directamente en HTML si el cascarón debe ser sin JS.
+  AÑADIDO POR BACKEND INCOMPLETO: el script terrenos-datos.js (datos de ejemplo)
+-->
+
+<html lang="es">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Terrenos - Gestión de Cultivos</title>
+    <link rel="stylesheet" href="css/admin.css">
+    <link rel="stylesheet" href="css/terrenos.css">
