+/*
+ * ARCHIVO: css/pedidos.css
+ * CAPA: FRONTEND (estilos, cascarón). Solo estilos de Pedidos: la tabla de la lista.
+ * USA: las variables de color de css/admin.css (--tarjeta, --borde, --texto, --texto-suave, --acento).
+ */
+
+.envoltura-tabla {
+    background: var(--tarjeta);
+    border: 1px solid var(--borde);
+    border-radius: 12px;
+    overflow-x: auto;
+}
+
+.tabla-pedidos {
+    width: 100%;
+    border-collapse: collapse;
+    min-width: 760px;
+}
+
+.tabla-pedidos th,
+.tabla-pedidos td {
+    padding: 12px 14px;
+    text-align: left;
+    border-bottom: 1px solid var(--borde);
+    white-space: nowrap;
+}
+
+.tabla-pedidos th {
+    color: var(--texto-suave);
+    font-size: 0.8rem;
+    font-weight: 600;
+    text-transform: uppercase;
+    letter-spacing: 0.04em;
+}
+
+.tabla-pedidos tbody tr:last-child td { border-bottom: none; }
+.tabla-pedidos tbody tr:hover { background: var(--tarjeta-2); }
+
+.celda-total { text-align: right; font-weight: 600; }
+.tabla-pedidos th.celda-total { text-align: right; }
+
+.enlace-pedido { color: var(--acento); text-decoration: none; font-weight: 600; }
+.enlace-pedido:hover { text-decoration: underline; }
+
+/* Texto solo para lectores de pantalla (encabezado de la columna de enlaces) */
+.solo-lectores {
+    position: absolute;
+    left: -9999px;
+}
\ No newline at end of file
