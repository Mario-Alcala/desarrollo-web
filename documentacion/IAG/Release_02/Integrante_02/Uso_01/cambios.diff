+        if (cosecha.getCantidadCosechada() == null
+                || cosecha.getCantidadCosechada()
+                        .compareTo(BigDecimal.ZERO) <= 0) {
+            throw new IllegalArgumentException(
+                    "La cantidad cosechada debe ser mayor que cero");
