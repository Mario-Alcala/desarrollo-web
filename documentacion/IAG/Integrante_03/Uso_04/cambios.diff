@@ -0,0 +1,93 @@
+<!DOCTYPE html>
+<!--
+  ARCHIVO: bodega.html
+  CAPA: FRONTEND (estructura). ¿ES CASCARÓN? SÍ en lo visual (HTML + CSS), pero el sidebar, la barra
+    superior y las tablas las dibuja JavaScript: sin JS la página sale casi vacía.
+  BACKEND: no se verificó una ruta de bodegas, inventario ni movimientos; los datos salen de js/admin-datos.js.
+  LE FALTA: guardar movimientos en la API; registrar herramientas nuevas; descontar kilos de cosecha al vender.
+  AÑADIDO POR BACKEND INCOMPLETO: el script admin-datos.js (bodegas, inventario, herramientas y movimientos de ejemplo).
+-->
+<html lang="es">
+<head>
+    <meta charset="UTF-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1.0">
+    <title>Bodega - Gestión de Cultivos</title>
+    <link rel="stylesheet" href="css/admin.css">
+    <link rel="stylesheet" href="css/admin-vistas.css">
+</head>
+<body class="admin">
+    <div class="app-admin">
+        <aside id="sidebar" class="sidebar-admin" data-activo="bodega"></aside>
+
+        <div class="contenido-admin">
+            <header id="topbar" class="topbar-admin" data-placeholder="Buscar en la bodega" data-local="true"></header>
+
+            <main class="pagina">
+                <div class="encabezado-pagina">
+                    <div>
+                        <h1>Bodega</h1>
+                        <p>Consulta los lotes de insumos, las herramientas y las cosechas disponibles. Las entradas y salidas se registran como movimientos de inventario.</p>
+                    </div>
+                    <button id="registrar-movimiento" class="boton" type="button">Registrar movimiento</button>
+                </div>
+
+                <div id="pestanas" class="barra-herramientas" role="group" aria-label="Elegir lista">
+                    <button class="filtro" type="button" data-valor="insumos" aria-pressed="true">Insumos</button>
+                    <button class="filtro" type="button" data-valor="herramientas" aria-pressed="false">Herramientas</button>
+                    <button class="filtro" type="button" data-valor="cosechas" aria-pressed="false">Cosechas</button>
+                    <button class="filtro" type="button" data-valor="movimientos" aria-pressed="false">Movimientos</button>
+                </div>
+
+                <div class="barra-herramientas">
+                    <label class="sr" for="filtro-bodega">Bodega</label>
+                    <select id="filtro-bodega">
+                        <option value="">Todas las bodegas</option>
+                    </select>
+                </div>
+
+                <p id="mensaje-bodega" class="mensaje" role="status"></p>
+                <div class="tabla-admin-contenedor">
+                    <table class="tabla-admin">
+                        <thead><tr id="tabla-cabecera"></tr></thead>
+                        <tbody id="tabla-cuerpo"></tbody>
+                    </table>
+                </div>
+            </main>
+        </div>
+    </div>
+
+    <dialog id="dialogo-movimiento" class="ancho" aria-labelledby="titulo-movimiento">
+        <h2 id="titulo-movimiento">Registrar movimiento</h2>
+        <form id="formulario-movimiento">
+            <label for="mv-lote">Lote de insumo</label>
+            <select id="mv-lote" required></select>
+
+            <div class="campos-dos">
+                <div>
+                    <label for="mv-tipo">Tipo de movimiento</label>
+                    <select id="mv-tipo" required>
+                        <option value="entrada">Entrada</option>
+                        <option value="salida">Salida</option>
+                    </select>
+                </div>
+                <div>
+                    <label for="mv-cantidad">Cantidad</label>
+                    <input id="mv-cantidad" type="number" min="0.01" step="0.01" required>
+                </div>
+            </div>
+            <p id="mv-ayuda" class="ayuda"></p>
+
+            <p id="mensaje-movimiento" class="mensaje error" role="alert"></p>
+            <div class="botones-pedido">
+                <button class="boton" type="submit">Guardar movimiento</button>
+                <button id="cancelar-movimiento" class="boton boton-secundario" type="button">Cancelar</button>
+            </div>
+        </form>
+    </dialog>
+
+    <script src="js/sidebar.js"></script>
+    <script src="js/admin-datos.js"></script>
+    <script src="js/admin-comun.js"></script>
+    <script src="js/bodega.js"></script>
+</body>
+</html>
